==============================================================================
N1: general-K dual certificate for the reduced LP  (results/N1_dual_certificate.py)
==============================================================================

--- PART A: dual feasibility A'y = c, symbolic in (K, j, t) ---
  [PASS] D2 at t=0 (j>=1): y_sum(0) = y_cons(0) forces it
  [PASS] D2 for 1 <= t <= j-1
  [PASS] D2 at t=j (j>=1)
  [PASS] D2 for j+1 <= t <= K-1
  [PASS] D2 at t=K (needs y_cons(K-1) = 0)
  [PASS] D2 at t=0 for the j=0 segment
  [PASS] D1 for t >= j: y_pred(t) + y_cons(t) = -1/K  (and sum_{s>t} y_sum(s) = 0)
  [PASS] D1 base at t=j-1: -y_sum(j) - K y_cons(j-1) = 1
  [PASS] D1 downward induction step for t <= j-2
  [PASS] b'y = V_j for j >= 1
  [PASS] b'y = V_0 = 1/eta for j = 0

--- PART B: primal feasibility and c'x = V_j, symbolic in (K, j, t) ---
  [PASS] P_t = 1-q^t for t<=j: step (1-q^{t+1}) - (1-q^t) = d_t = q^t/k1
  [PASS] P_t for t>=j: step = d_t = q^j/(K eta)
  [PASS] P_t claims agree at t=j
  [PASS] sum(t) is TIGHT for t <= j:  K G_t = q^t = r_t
  [PASS] sum(t) slack for t > j equals (t-j) q^j/(K eta) >= 0
  [PASS] pred(t) slack for t < j equals q^t (eta-1)/(K eta k1) >= 0
  [PASS] pred(t) is TIGHT for t >= j
  [PASS] mono(t) slack for t < j equals q^t/(K k1) > 0
  [PASS] mono(t) is TIGHT for t >= j (G frozen)
  [PASS] cons(t) is TIGHT for t < j
  [PASS] cons(t) is TIGHT for t >= j
  [PASS] c'x = P_K = 1 - q^j(1-(K-j)/(K eta)) = V_j

--- PART C: sign conditions y <= 0 on the segment, symbolic in (K, j, t) ---
  [PASS] k1 > 0 on segment j>=1   (coeffs=[1, 1, 1, 1, 1, 2])
  [PASS] numerator of q is > 0  =>  q > 0   (coeffs=[1, 1, 1, 1, 1, 1])
  [PASS] M = K eta - (K-j) > 0 on segment j>=1   (coeffs=[1, 1, 1, 1, 2, 1])
  [PASS] -y_sum(j) numerator = K-j+1-eta = 1-s >= 0 (=0 at eta=K-j+1)   (coeffs=[1])
  [PASS] K k1 > 0  =>  y_sum(0), y_cons(t<=j-1) <= 0 (with q>0, M>0)   (coeffs=[1, 1, 1, 3, 3, 4, 2, 2, 4])
  [PASS] k1^2 > 0  =>  y_sum(1..j-1) <= 0   (coeffs=[1, 2, 2, 1, 2, 1, 2, 4, 6, 2, 6, 4, 1, 2, 4, 1, 4, 4])
  [PASS] j<=K-2: K(eta-1) > 0 on [K-j, K-j+1]   (coeffs=[1, 1, 1, 2, 2, 2])
  [PASS] -y_pred(j+m) numerator = eta-(K-j-m) = s+m >= 0 (=0 at eta=K-j, m=0)   (coeffs=[1, 1])
  [PASS] -y_cons(j+m) numerator = K-1-t = u-1-m >= 0   (coeffs=[1])
  [PASS] j=K-1: y_pred(K-1) = -(eta-1)/(K(eta-1)) = -1/K (removable at eta=1)
  [PASS] j=K-1: y_cons(K-1) = -(K-1-(K-1))/(K(eta-1)) = 0
  [PASS] j=0: K(eta-1) > 0 on [K,oo)   (coeffs=[1, 1, 3, 2, 2])
  [PASS] j=0: -y_pred(t) numerator = eta-(K-t) = s+t >= 0 on [K,oo)   (coeffs=[1, 1])
  [PASS] j=0: -y_cons(t) numerator = K-1-t >= 0   (coeffs=[1])
  [PASS] j=0: -y_sum(0) = 1/eta > 0   (coeffs=[1, 1, 2])

--- PART D: V_j = min_i V_i on segment j, symbolic in (K, j, i) ---
  [PASS] V_i - V_{i+1} = q^i (K-i-eta) / (K eta k1)
  [PASS] i<=j-1 on segment: K-i-eta = 1+a-s >= 0   (coeffs=[1, 1])
  [PASS] i>=j on segment: -(K-i-eta) = a+s >= 0   (coeffs=[1, 1])
  [PASS] V_0 = 1/eta
  [PASS] V_j - V_{j-1} = 0 exactly at eta = K-j+1 (breakpoints are integers)
  [PASS] U_K - V_{K-1} = q^{K-1}(eta-1)/(K eta k1) >= 0 for eta >= 1

